# Example environment variables for MAAS
# Copy this file to .env and fill in your actual values

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_PATH=./data/maas.db

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Environment
ENVIRONMENT=development
# Options: development, staging, production

# ACSoft Configuration (Windows paths)
ACSOFT_PATH=C:\Program Files\ACSoft\ACSoft.exe
ACSOFT_WINDOW_TITLE=ACSoft

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# File Storage
UPLOAD_PATH=./data/uploads/
PROCESSED_PATH=./data/processed/
SCREENSHOTS_PATH=./data/screenshots/

# Security (optional for local development)
# API_KEY=your_optional_api_key
# ALLOWED_IPS=127.0.0.1,::1

# Gemini API Settings
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Validation Settings
MIN_CONFIDENCE_THRESHOLD=0.85

# Development Settings (set to false in production)
DEBUG=false
AUTO_RELOAD=false
